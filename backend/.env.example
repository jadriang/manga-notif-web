# Clerk
CLERK_JWKS_URL=https://<frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<frontend-api>.clerk.accounts.dev

# Database (Neon Postgres)
DATABASE_URL=postgresql+asyncpg://user:pass@host/db?ssl=require

# Telegram
TELEGRAM_BOT_TOKEN=
# Required to accept Telegram webhook calls; set the same value when registering
# the webhook (setWebhook ?secret_token=...). Webhook is rejected if unset.
TELEGRAM_WEBHOOK_SECRET=

# Cron — must be non-empty; the /api/cron/check endpoint is refused if unset.
CRON_SECRET=

# CORS
FRONTEND_URL=http://localhost:5173
